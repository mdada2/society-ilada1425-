<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_society_mitra"
            android:contentDescription="Society Mitra" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Society Mitra"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1e293b"
            android:paddingStart="8dp"
            android:paddingEnd="0dp" />
    </LinearLayout>

    <!-- Ask Question Button -->
    <Button
        android:id="@+id/ask_question_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_header"
        android:text="प्रश्न विचारा"
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:background="@drawable/button_background"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

    <!-- Last Query Section -->
    <LinearLayout
        android:id="@+id/last_query_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/ask_question_button"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:background="@drawable/response_background"
        android:padding="8dp">

        <TextView
            android:id="@+id/last_query_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="शेवटचा प्रश्न:"
            android:textSize="10sp"
            android:textColor="#64748b"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/last_query_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="कर्ज बाकी किती आहे?"
            android:textSize="12sp"
            android:textColor="#334155"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/last_answer_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="उत्तर:"
            android:textSize="10sp"
            android:textColor="#64748b"
            android:textStyle="bold"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/last_answer_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="एकूण कर्ज बाकी ₹45,000 आहे..."
            android:textSize="12sp"
            android:textColor="#1e293b"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/tap_to_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="संपूर्ण उत्तर पाहण्यासाठी टॅप करा ➜"
            android:textSize="10sp"
            android:textColor="#3b82f6"
            android:paddingTop="4dp" />
    </LinearLayout>

</RelativeLayout>
